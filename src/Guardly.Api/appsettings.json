{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Azure.Core": "Warning",
      "Azure.Identity": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Storage": {
    "AccountName": "",
    "ImageContainer": "images",
    "InspectionContainer": "inspections",
    "QueueName": "inspection-jobs",
    "UseInMemory": false
  },

  "Vision": {
    "Endpoint": "",
    "ApiVersion": "2024-02-01",
    "Features": "tags,objects,people",
    "TimeoutSeconds": 30,
    "MaxRetries": 3,
    "UseFake": false
  },

  "SafetyRules": {
    "MinimumConfidence": 0.55,
    "PersonConfidence": 0.6
  },

  "Worker": {
    "Enabled": true,
    "MaxConcurrentAnalyses": 3,
    "BatchSize": 8,
    "MinPollDelaySeconds": 1,
    "MaxPollDelaySeconds": 30,
    "MaxDequeueCount": 5
  },

  "Api": {
    "MaxImageSizeMb": 20
  }
}
